#!/usr/bin/env bash
# Aplica no HDMI-A-1 o modo WxH com a frequência mais próxima de F (uso: void-mode 1920x1080@120).
# Existe porque o kscreen-doctor não aceita frequência com casas decimais (1920x1080@119.88) e,
# com "@120", casa com outro modo. Aqui a busca é por id.
set -u
OUT=HDMI-A-1
[[ "${1:-}" =~ ^([0-9]+)x([0-9]+)@([0-9.]+)$ ]] || { echo "uso: $0 WxH@F" >&2; exit 2; }
W=${BASH_REMATCH[1]} H=${BASH_REMATCH[2]} F=${BASH_REMATCH[3]}
id=$(kscreen-doctor -o 2>&1 | sed 's/\x1b\[[0-9;]*m//g' | grep -oE '[0-9]+:[0-9]+x[0-9]+@[0-9.]+' |
  awk -F'[:x@]' -v W="$W" -v H="$H" -v F="$F" '
    $2==W && $3==H { d=$4-F; if (d<0) d=-d; if (best=="" || d<bd) {bd=d; best=$1} }
    END { print best }')
[ -n "$id" ] || { echo "void-mode: $W x $H não existe no $OUT" >&2; exit 1; }
kscreen-doctor output.$OUT.mode.$id
