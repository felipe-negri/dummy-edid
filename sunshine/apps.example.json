{
    "env": {
        "PATH": "$(PATH):$(HOME)/.local/bin",
        "XDG_RUNTIME_DIR": "/run/user/1000",
        "WAYLAND_DISPLAY": "wayland-0"
    },
    "apps": [
        {
            "name": "Desktop",
            "image-path": "/usr/share/sunshine/desktop.png"
        },
        {
            "name": "📱 S26 Ultra 3120x1440 @ 120fps",
            "image-path": "/home/USER/.config/sunshine/covers/3120_1440_120.png",
            "prep-cmd": [
                {
                    "do": "/home/USER/.local/bin/void-mode 3120x1440@120",
                    "undo": "/home/USER/.local/bin/void-mode 1920x1080@60"
                },
                {
                    "do": "setsid steam steam://open/bigpicture",
                    "undo": "/home/USER/.local/bin/steam-close.sh"
                }
            ]
        },
        {
            "name": "📱 S26 Ultra 2340x1080 @ 120fps",
